+    /** D542: shallow work is left -- fewer than {@code maxRounds} complete rounds and an active alternative not settled. */
+    public static boolean shallowLeft(final boolean[] active, final boolean[] settled, final int complete, final int maxRounds) {
+        if (complete >= maxRounds) {
+            return false;
+        }
+        for (int i = 1; i < active.length; i++) {
+            if (active[i] && !settled[i]) {
+                return true;
+            }
+        }
+        return false;
+    }
