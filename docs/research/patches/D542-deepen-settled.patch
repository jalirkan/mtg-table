+    /**
+     * D542: this decision state's deep legs, Forge's answer (0) not included -- only where the verdict can still move.
+     * Under {@link #deepChoice} only the shallow best's veto matters, and a promotion acts only when the shallow rule
+     * keeps Forge's answer.  So, with {@code b} the shallow best over the active alternatives ({@link #best} on their
+     * paired differences, {@code rounds} the evidence it needs): (a) if {@code b} is a winner above {@code margin} and
+     * not deepened, no deep legs at all (it cannot be vetoed and nothing can be promoted over it); (b) if {@code b} is
+     * a deepened winner, {@code b} first, then the deepened near-ties ({@code -margin <= diff <= margin}, active or
+     * retired) best-first, since their promotion matters if {@code b} is vetoed, which is unknown until the end; (c)
+     * with no winner above the margin, the deepened near-ties best-first; (d) any other settled winner gets no leg.
+     * A comparison marked {@code done} gets none.  Pure, and recomputed from the current rounds every time it is
+     * asked, so under {@code deepmix=1} a shallow best that changes between rounds changes the legs with it.
+     */
+    public static List<Integer> deepLegs(final boolean[] deepened, final boolean[] done, final boolean[] active,
+                                         final List<double[]> leaves, final int margin, final int rounds) {
+        final int k = deepened.length;
+        final double[] diff = new double[k];
+        for (int i = 1; i < k; i++) {
+            diff[i] = standing(leaves, i);
+        }
+        final int b = best(active, leaves, diff, rounds);
+        final boolean winner = b > 0 && diff[b] > margin;
+        final List<Integer> legs = new ArrayList<>();
+        if (winner && !deepened[b]) {
+            return legs;   // (a)
+        }
+        if (winner && !done[b]) {
+            legs.add(b);   // (b): the veto is checked on what would be played
+        }
+        final List<Integer> ties = new ArrayList<>();
+        for (int i = 1; i < k; i++) {
+            if (deepened[i] && !done[i] && diff[i] >= -margin && diff[i] <= margin) {
+                ties.add(i);   // (b), (c): near-ties, active or retired
+            }
+        }
+        ties.sort((x, y) -> Double.compare(diff[y], diff[x]));
+        legs.addAll(ties);
+        return legs;
+    }
+
+    /** D542: whether this round runs deep legs -- only when no shallow work is left, unless {@code deepmix=1}. */
+    public static boolean deepThisRound(final boolean shallowLeft, final boolean deepmix) {
+        return deepmix || !shallowLeft;
+    }
