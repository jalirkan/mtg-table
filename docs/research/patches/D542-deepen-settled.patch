+                        rep.retired += out;
+                        sink.add("search.anytime.retired", out);
+                    }
+                }
+                // ---- the deep legs: Forge's answer and each deepened alternative whose verdict could change the
+                // choice, at horizon + 1, this round's seed; shallow first: only in a round that started with no
