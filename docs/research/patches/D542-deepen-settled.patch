+    /** D542: a deepened comparison's verdict -- not deepened, deepened with no verdict, a veto, a promotion. */
+    public static final int DEEP_NONE = 0;
+    public static final int DEEP_HELD = 1;
+    public static final int DEEP_VETO = 2;
+    public static final int DEEP_PROMOTE = 3;
+
+    /** D542: the fewest deep paired rounds a deep verdict is read on (fewer, and the shallow verdict stands). */
+    public static final int DEEP_MIN = 3;
+
+    /** D542: the record's word for a deep verdict ({@code null} for {@link #DEEP_NONE}). */
+    public static String deepWord(final int v) {
+        return v == DEEP_VETO ? "veto" : v == DEEP_PROMOTE ? "promote" : v == DEEP_HELD ? "held" : null;
+    }
