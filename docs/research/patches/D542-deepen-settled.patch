+                rep.ms = (System.nanoTime() - t0) / 1_000_000L;
+                Report.fillStats(rep, leaves, wins, k);
+                rep.rounds = complete;
+                if (!deepOff) {
+                    for (final int i : Anytime.deepLegs(deepened, deepDone, active, leaves, cfg.margin, cfg.minRounds)) {
