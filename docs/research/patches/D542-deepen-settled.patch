+    /**
+     * D542: whether candidate {@code i}'s comparison with Forge's answer (0) is
+     * settled -- scored in at least {@code from} rounds with Forge's, and every one
+     * of those rounds' differences {@code row[i] - row[0]} exactly the same, which is
+     * a paired standard error of exactly 0 without the rounding of computing one.
+     * Further rounds at this horizon re-measure the same number (D540's Context).
+     */
+    public static boolean settled(final List<double[]> leaves, final int i, final int from) {
+        int n = 0;
+        double first = 0;
+        for (final double[] row : leaves) {
+            if (Double.isNaN(row[i]) || Double.isNaN(row[0])) {
+                continue;
+            }
+            final double d = row[i] - row[0];
+            if (n == 0) {
+                first = d;
+            } else if (d != first) {
+                return false;
+            }
+            n++;
+        }
+        return n >= from;
+    }
+
+    /**
+     * D542: the verdict on one deepened comparison, from its shallow paired
+     * difference {@code shallowDiff} to Forge's answer and {@code deep}, its deep
+     * paired difference as {@link #pairedDiff} gives it ({mean, se, n}; null with no
+     * deep pair).  Conservative both ways, with {@code z} the key's value:
+     * <ul>
+     * <li>a shallow winner ({@code shallowDiff > margin}) is VETOED when
+     *     {@code mean + z·se < 0};</li>
+     * <li>a near-tie ({@code -margin <= shallowDiff <= margin}) is PROMOTED when
+     *     {@code mean - z·se > margin};</li>
+     * <li>otherwise, or with fewer than {@link #DEEP_MIN} deep pairs, or an se that
+     *     is not a number, it is HELD: the shallow verdict stands.</li>
+     * </ul>
+     * A deep se of exactly 0 over {@link #DEEP_MIN} or more pairs is a legitimate
+     * reading (every deep pair answered alike, as most shallow ones do): the bound
+     * is then the plain mean, against 0 or the margin.  A comparison below
+     * {@code -margin} is never deepened; asked anyway, it is HELD.
+     */
+    public static int deepVerdict(final double shallowDiff, final double[] deep, final int margin, final double z) {
+        if (deep == null || deep[2] < DEEP_MIN || Double.isNaN(deep[0]) || Double.isNaN(deep[1])) {
+            return DEEP_HELD;
+        }
+        if (shallowDiff > margin) {
+            return deep[0] + z * deep[1] < 0 ? DEEP_VETO : DEEP_HELD;
+        }
+        if (shallowDiff >= -margin) {
+            return deep[0] - z * deep[1] > margin ? DEEP_PROMOTE : DEEP_HELD;
+        }
+        return DEEP_HELD;
+    }
+
+    /**
