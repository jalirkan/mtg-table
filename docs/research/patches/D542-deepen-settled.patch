+            sink.add(pre + "decisions", 1);
+        }
+        if (Anytime.starved(clockWanted, deep)) {
+            sink.add(pre + "starved", 1);   // every comparison that wanted depth ended under DEEP_MIN deep pairs
+        }
+        if (chosen != shallow) {
+            sink.add(pre + "changed", 1);
+        }
+        o.chosen = chosen;
+        rep.shallowChosen = shallow;
+        rep.best = best;
+        rep.chosen = chosen;
+        rep.overrode = chosen > 0;
+        if (REPORT_EVENTS) {
+            sink.event(rep.summary());
+        }
+        return o;
+    }
