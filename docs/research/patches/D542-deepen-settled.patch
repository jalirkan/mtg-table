+        if (cfg.rolloutMix()) {
+            countMixPairs(leaves, best, sink);
+        }
+        // the deep verdicts, then the choice (Anytime.deepChoice: a veto is never played, a promotion acts only
+        // where the shallow rule keeps Forge's answer)
+        final double[] deepMean = new double[k];
+        Arrays.fill(deepMean, Double.NaN);
+        // only the comparisons the rule wanted deepened (Anytime.deepLegs) are judged and counted: .pairs, .decisions,
+        // .short and .starved; .starved is the clock's alone, so a comparison whose deep legs ended on errors, and every
+        // comparison of a decision whose deepening two Forge deep-leg errors turned off, is left out of it
+        int pairs = 0;
+        final boolean[] clockWanted = new boolean[k];
+        for (int i = 1; i < k; i++) {
+            if (!wanted[i]) {
+                continue;
+            }
+            pairs++;
+            sink.add(pre + "pairs", 1);
+            clockWanted[i] = !deepOff && deepErrs[i] < 2;
+            final double[] d = Anytime.pairedDiff(deep, i, 0);
+            final int v = Anytime.deepVerdict(rep.diffLeaf[i], d, cfg.margin, cfg.deepen);
+            rep.deepVerdict[i] = v;
+            deepMean[i] = d == null ? Double.NaN : d[0];
+            if (d == null || d[2] < Anytime.DEEP_MIN) {
+                sink.add(pre + "short", 1);
+            }
+            if (v == Anytime.DEEP_VETO) {
+                sink.add(pre + "vetoes", 1);
+            } else if (v == Anytime.DEEP_PROMOTE) {
+                sink.add(pre + "promotions", 1);
+            }
+        }
+        final int chosen = Anytime.deepChoice(active, leaves, rep.diffLeaf, cfg.minRounds, cfg.margin, rep.deepVerdict,
