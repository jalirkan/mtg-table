+    private Outcome searchDeepen(final Player ai, final List<Cand> cands, final String kind, final long t0) {
+        final long deadline = t0 + budgetFor(kind) * 1_000_000L;
+        final Game game = ai.getGame();
+        final int k = cands.size();
+        final int horizon = horizonFor(kind);
+        final int deepHorizon = horizon + 1;
+        final String pre = "search." + kind + ".deepen.";
+        final List<double[]> leaves = new ArrayList<>();
+        final List<double[]> wins = new ArrayList<>();
+        final List<double[]> deep = new ArrayList<>();
+        final boolean[] active = new boolean[k];
+        Arrays.fill(active, true);
+        final boolean[] settled = new boolean[k];
+        final boolean[] deepened = new boolean[k];
+        final boolean[] deepDone = new boolean[k];
+        final boolean[] wanted = new boolean[k];   // the comparisons the rule gave a deep leg, or wants one at the end
+        final int[] errs = new int[k];
+        final int[] deepErrs = new int[k];
+        int errors = 0;
+        int complete = 0;
+        long rolloutNs = 0;
+        int timed = 0;
+        boolean deepOff = false;
+        boolean finished = false;
+        boolean deepRan = false;
+        // a deep rollout's counters go under search.<k>.deepen. (its playUs, copyUs, stepTimeouts, ...), so every
+        // shallow statistic -- search.rollouts, search.playUs, search.copyUs, search.stepTimeouts -- keeps its meaning
+        final Sink deepSink = new Sink() {
+            @Override
+            public void add(final String key, final int n) {
+                sink.add(key.startsWith("search.") ? pre + key.substring("search.".length()) : key, n);
+            }
+
+            @Override
+            public void event(final String text) {
+                sink.event(text);
+            }
+        };
+        final Report rep = new Report();
+        report = rep;
+        rep.kind = kind;
+        rep.cands = new ArrayList<>(cands);
+        rep.budgetMs = budgetFor(kind);
+        rep.horizon = horizon;
+        rep.rule = "margin";   // SearchConfig refuses deepen with override=lcb, and p, a, b take the config's rule
+        rep.z = 0;
+        rep.margin = cfg.margin;
+        rep.leaves = leaves;
+        rep.anytime = true;
+        rep.deepen = cfg.deepen;
+        rep.deepLeaves = deep;
+        attachPrior(rep, cands);
+        if (Determinizer.hiddenFaceDown(game, ai) > 0) {
+            sink.add("search.oppFaceDownDecisions", 1);
+        }
+        try {
+            rounds:
+            while (System.nanoTime() < deadline) {
+                final boolean shallowLeft = Anytime.shallowLeft(active, settled, complete, cfg.maxRounds);
+                final boolean deepLeft = !deepOff && !Anytime.deepLegs(deepened, deepDone, active, leaves, cfg.margin, cfg.minRounds).isEmpty();
+                if (!shallowLeft && !deepLeft) {
+                    finished = true;
+                    break;   // decided: every alternative settled, raced out or pruned, and no deep leg can change the choice
+                }
+                final long seed = rng.nextLong();
+                if (shallowLeft) {
+                    // ---- the shallow legs: searchAnytime's round over the unsettled alternatives ----
+                    final int r = leaves.size();
+                    final boolean[] rolling = new boolean[k];
+                    rolling[0] = true;
+                    for (int i = 1; i < k; i++) {
+                        rolling[i] = active[i] && !settled[i];
+                    }
+                    if (r > 0 && timed > 0) {
+                        final int cut = Anytime.pruneToBudget(rolling, leaves, rolloutNs / timed, deadline, r, cfg.minRounds);
+                        if (cut > 0) {
+                            for (int i = 1; i < k; i++) {
+                                if (active[i] && !settled[i] && !rolling[i]) {
+                                    active[i] = false;   // pruned, as searchAnytime prunes
+                                }
+                            }
+                            rep.pruned += cut;
+                            sink.add("search.anytime.pruned", cut);
+                        }
+                    }
+                    final double[] round = new double[k];
+                    final double[] roundWin = new double[k];
+                    Arrays.fill(round, Double.NaN);
+                    Arrays.fill(roundWin, Double.NaN);
+                    leaves.add(round);
+                    wins.add(roundWin);
+                    boolean full = true;
+                    for (final int i : Anytime.order(rolling, leaves, r)) {
+                        final long tr = System.nanoTime();
+                        final Playout p;
+                        try {
+                            p = rollout(game, ai, cands.get(i), seed, deadline, r == 0 && i == 0, horizon, r);
+                        } catch (final CopyFailed e) {
+                            throw e;
+                        } catch (final CandidateUnmappable e) {
+                            if (i == 0) {
+                                sink.add("search.fallback.unmappable", 1);
+                                rep.fallback = "unmappable";
+                                return null;
+                            }
+                            sink.add("search.candidateUnmappable", 1);
+                            active[i] = false;
+                            continue;
+                        } catch (final RuntimeException | StackOverflowError e) {
+                            errors++;
+                            errs[i]++;
