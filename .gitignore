# --- build output -----------------------------------------------------------
bridge/out/
web/node_modules/
web/dist/

# --- generated at setup / runtime -------------------------------------------
# Forge's redirected profile (24 dirs, prefs, logs) + var/games/<id>/frames.jsonl
var/
# written by tools/fetch-art.ts from Scryfall; regenerate, never commit
web/public/art.json

# --- never commit the engine ------------------------------------------------
# The Forge fat jar is 39 MB and carries GPL redistribution obligations.
# Its path comes from config.json or $FORGE_JAR.
*.jar
# symlink into the user's own Forge install (/home/justin-a/forge/res)
forge-home/res
# regenerated by tools/make-forge-home.sh with ABSOLUTE userDir/cacheDir paths,
# so it is machine-specific and must not be committed
forge-home/forge.profile.properties

# --- noise ------------------------------------------------------------------
.DS_Store
*.log
